<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Locality</title>

    <script src="/js/request.js" defer></script>
    <link rel="stylesheet" href="/css/background.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.1/dist/tailwind.min.css" />
</head>

<body>
<%- include('./partials/headerView.ejs'); %>
    
    
  
    <main class="flex items-center justify-center p-12 mb-2 mt-2 rounded-lg">
        <div class="bg-gradient-to-r from-black via-green-600 to-black shadow-md border border-white rounded-lg w-full max-w-lg min-w-max">

            <div class="flex justify-around flex-wrap bg-gray-200 p-4 rounded-t-lg">
                <form action="/Login" method="GET">
                    <button id="login-btn" class="text-blue-800 font-semibold">Connexion</button>
                </form>
            </div>

            <section id="register-section" class="p-4">
                <h2 class="text-2xl font-bold text-center text-red-600 mb-4 border border-red-600 rounded-lg p-1">Registration</h2>
                <form action="#" method="POST">
                   
                    <div class="mb-2 ">
                        <label for="register-name" class="block text-red-600">Name</label>
                        <input type="text" id="register-name" name="name"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>

                    <div class="mb-2 ">
                        <label for="register-lastname" class="block text-red-600">Lastname</label>
                        <input type="text" id="register-lastname" name="lastname"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>
                    
                     <div class="mb-2">
                        <label for="register-password" class="block text-red-600">Password</label>
                        <input type="password" id="register-password" name="password"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>

                    <div class="mb-2">
                        <label for="confirm-password" class="block text-red-600">Confirmed Password</label>
                        <input type="password" id="confirm-password" name="confirmed_password"
                                class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                                required>
                    </div>

                    <div class="mb-2">
                        <label for="register-email" class="block text-red-600">E-mail</label>
                        <input type="email" id="register-email" name="email"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>
                  
                    <div class="mb-2">
                        <label for="adresse" class="block text-red-600">Adresse</label>
                        <input type="text" id="adresse" name="adresse"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>

                    <div class="mb-2">
                        <label for="city" class="block text-red-600">City</label>
                        <input type="text" id="city" autocomplete="off" name="city"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required/>
                        <input type="text" id="lat" name="lat" class="hidden" required/>
                        <input type="text" id="lon" name="lon" class="hidden" required/>
                        <input type="number" id="cp" name="cp" class="hidden" required/>
                        <div id="suggestions"></div>
                    </div>

                    <div class="mb-2">
                        <label for="tel" class="block text-red-600">Tel</label>
                        <small class="text-red-600">Format: 00-00-00-00-00</small>
                        <input type="tel" pattern="[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}" id="tel" name="tel"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>
                    
                    <div class="mb-2">
                        <label for="birth_date" class="block text-red-600">Birth Date</label>
                        <input type="date" id="birth_date" name="birth_date"
                            class="w-full px-4 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-blue-500"
                            required>
                    </div>

                     
                    <div class="mb-2 flex">
                        
                        <input type="radio" id="role_buyer" name="role" value="buyer" class="mr-2" checked/>
                        <label for="role_buyer" class="block text-red-600">Buyer Account</label>
                    </div>

                    <div class="mb-2 flex">
                        <input type="radio" id="role_seller" name="role" value="seller" class="mr-2" />
                        <label for="role_seller" class="block text-red-600">Seller Account</label>
                    </div>

                    <div class="mb-2">
                        <button type="submit"
                            class="w-full bg-blue-800 text-white py-2 px-4 rounded-md hover:bg-blue-900">Register</button>
                    </div>

                </form>
                <% if (successMessage) { %>
                    <div class="border-2 border-green-600 text-center text-green-600">
                        <%= successMessage %>
                    </div>
                <% } %>

                <% if (errorMessage) { %>
                    <div class="border-2 border-red-600 text-center text-red-600">
                     <%= errorMessage %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
    <%- include('./partials/footerView.ejs'); %>
</body>

</html>