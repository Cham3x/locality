
<!--------------------------------------Add product From View------------------------------------------->  
<%if(subRoute === 'addPf'){ %>
   
    <h1 class="text-black font-bold mb-1">Add a new Product :</h1>
            <form action="/Manage/Myproducts/addP" method="POST">
            <table>
                <tr>
                    <td>
                        <input type="text" id="product-name" name="name" placeholder="Product Name" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required>
                    </td>
                    <td>
                        <input type="text" id="product-price" name="price" placeholder="Product Price" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required>
                    </td>
                </tr>
               
                <tr>
                    <td>
                        <input type="text" id="product-cat" name="cat" placeholder="Product Category" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"
                                required/>
                    </td>
                    <td >
                        <input type="text" id="product-stock" name="stock" placeholder="Product Stock" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required/>
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="checkbox" id="product-click" name="click" value="1" class="mt-3 ml-8 mr-2" />
                        <label for="product-click" class=" text-black border-1 border-black rounded-lg text-center ">Click & Collect</label>
                    </td>
                    <td>
                        <input type="checkbox" id="product-deliv" name="delivery" value="1" class="mt-3 ml-8 mr-2" />
                        <label for="product-deliv" class=" text-black border-1 border-black rounded-lg text-center ">Delivery</label>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <textarea type="text" id="product-desc" name="desc" placeholder="Product description..." class="resize-none rounded-md text-black border-1 border-black w-6/6 h-20 mt-2" required></textarea>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <input type="hidden" name="sellerId" value="<%= rows.sellerId %>"/>
                        <button type="submit" class="w-full bg-blue-800 text-white py-2 px-4 rounded-md hover:bg-blue-900">Add</button>
                    </td>
                </tr>

            </table>
            </form>
            <%}%>
<!-------------------------------------------Show Product view----------------------------------------------->    
    <%if(subRoute === 'showP'){%>
        <%if(rows){ %>
            <% rows.forEach(row => { %>
                <div class="border-3 border-black rounded-md mt-2 px-2">
                    <table>
                        <tr>
                            <td>
                                Product Name : <%= row.name %>
                            </td>
                            <td>
                                Product Category : <%= row.cat %>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Product Price : <%= row.price %>
                            </td>
                            <td>
                                Product Stock : <%= row.stock %>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Click & Collect : <%= row.click_collect %>
                            </td>
                            <td>
                                Delivery : <%= row.delivery %>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Product Date Creation : <%= row.date_creation %>
                            </td>
                            <td>
                                Product Description : <%= row.description %>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <form action ="/Manage/Myproducts/updtPf" method="POST" class="w-full flex justify-center">
                                <input type="hidden" name="productId" value="<%= row.id %>"/>
                                <button type="submit" name="update" value="1" class=" bg-white rounded-lg border-1 border-green-600 font-bold py-0.5 px-1 mt-2 mb-2">Update Product</button>
                                <button type="submit" name="del" value="1" class=" bg-white rounded-lg border-1 border-green-600 font-bold py-0.5 px-1 mt-2 mb-2 ml-2">Delete Product</button>
                                </form>
                            </td>
                        </tr>
                    </table>
                </div>
            <% }) %>
        <% } %>

             <% if(!rows){%>   
            <div class="border-1 border-black">
                No product registered
            </div>
            <%}%>
    <% } %>

<!----------------------------------------------Update Product Form View---------------------------------------->

    <%if(subRoute === 'updtPf'){%>
        <%if(rows){ %>
            <% rows.forEach(row => { %>
                <div class="border-3 border-black rounded-md mt-2 px-2">
                    <table>
                         <form action ="/Manage/Myproducts/updtP" method="POST">
                        <tr>
                            <td>
                               
                                Product Name : <%= row.name %>
                                <input type="text" name="name" placeholder="Update Product Name" class="w-6/6 px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"/>
                            </td>
                            <td>
                                Product Category : <%= row.cat %>
                                <input type="text" name="cat" placeholder="Update Product Category" class="w-6/6 px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Product Price : <%= row.price %>
                                <input type="text" name="price" placeholder="Update Product Price" class="w-6/6 px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"/>
                            </td>
                            <td>
                                Product Stock : <%= row.stock %>
                                <input type="text" name="stock" placeholder="Update Product Stock" class="w-6/6 px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white">
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Click & Collect : <%= row.click_collect %>
                                <input type="checkbox" id="product-click" name="click" value="1" class="mt-3 ml-8 mr-2" />
                                <label for="product-click" class=" text-black border-1 border-black rounded-lg text-center ">Update Click & Collect</label>
                            </td>
                            <td>
                                Delivery : <%= row.delivery %>
                                <input type="checkbox" id="product-deliv" name="delivery" value="1" class="mt-3 ml-8 mr-2" />
                        <label for="product-deliv" class=" text-black border-1 border-black rounded-lg text-center ">Update Delivery</label>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Product Date Creation : <%= row.date_creation %>
                            </td>
                           
                        </tr>
                        <tr>
                            <td colspan="2">
                                 Product Description : <%= row.description %>
                                <textarea type="text" name="desc" placeholder="Update Product description" class="resize-none rounded-md text-black border-1 border-black w-6/6 h-20 mt-2" ></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td >
                                
                                <input type="hidden" name="productId" value="<%= row.id %>"/>
                                <button type="submit" name="update" value="1" class=" bg-white rounded-lg border-1 border-green-600 py-0.5 px-1 mt-2 mb-2">Update</button>
                                
                            </td>
                        </tr>
                        </form>
                        <% if (message) { %>
                            <tr>
                                <td colspan="2">
                                    <div class="border-2 border-green-600 text-center text-black w-full rounded-lg mb-2">
                                        <%= message %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </table>
                </div>
            <% }) %>
        <% } %>

        <%}%>
<!--------------------------------------------Delete Product Form------------------------------------------------>

<%if(subRoute === 'delPf'){%>
    <%if(rows){ %>
        <% rows.forEach(row => { %>
            <h1 class="border-2 border-red-600">Are you sure you want to delete this product ?</h1>
            <div class="border-3 border-black rounded-md mt-2 px-2">
                <table>
                    <tr>
                        <td>
                            Product Name : <%= row.name %>
                        </td>
                        <td>
                            Product Category : <%= row.cat %>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Product Price : <%= row.price %>
                        </td>
                        <td>
                            Product Stock : <%= row.stock %>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Click & Collect : <%= row.click_collect %>
                        </td>
                        <td>
                            Delivery : <%= row.delivery %>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Product Date Creation : <%= row.date_creation %>
                        </td>
                        <td>
                            Product Description : <%= row.description %>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <form action ="/Manage/Myproducts/delP" method="POST" class="w-full flex justify-center">
                            <input type="hidden" name="sellerId" value="<%= row.id_sellers %>"/>
                            <input type="hidden" name="productId" value="<%= row.id %>"/>
                            <button type="submit" name="del" value="1" class=" bg-white rounded-lg border-1 border-green-600 font-bold py-0.5 px-1 mt-2 mb-2 ml-2">Delete</button>
                            </form>
                        </td>
                    </tr>
                </table>
            </div>
        <% }) %>
    <% } %>

<% } %>