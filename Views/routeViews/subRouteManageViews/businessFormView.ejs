<%if(subRoute === 'addB'){ %>
<h1 class="text-black font-bold mb-1">Add a new business :</h1>
        <form action="/Manage/Mybusiness/addB" method="POST">
        <table>
            <tr>
                <td>
                    <input type="text" id="business-name" name="name" placeholder="Your business Name" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required>
                </td>
                <td>
                    <input type="text" id="adresse" name="address" placeholder="Your business address" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="text" id="city" name="city" placeholder="Your business city" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white" required>
                    <input type="text" id="lat" name="lat" class="hidden" required/>
                    <input type="text" id="lon" name="lon" class="hidden" required/>
                    <input type="text" id="cp" name="cp" class="hidden" required/>
                    <div id="suggestions"></div>
                </td>
                <td>
                    <input type="email" id="business-email" name="email" placeholder="Your business email" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"
                            required>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="text" id="business-kbis" name="kbis" placeholder="Your kbis number" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"
                            required>
                </td>
                <td>
                    
                    
                    <select name="cat" id="cat" class="border-1 border-black rounded-lg text-center py-1 w-full">
                    <option class="" value="">Business category</option>
                    <% rows.forEach(row => { %>
                    <option value="<%= row.name %>"><%= row.name %></option>
                    <% })%>
                    </select>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="tel" pattern="[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2}" id="business-tel" name="tel" placeholder="Your business phone" class="w-full px-4 py-1 border border-black rounded-md focus:outline-none focus:ring focus:border-white"
                            required>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="checkbox" id="business-delivery-click" name="click" value="1" class="mt-3 ml-8 mr-2" />
                    <label for="business-delivery-click" class=" text-black border-1 border-black rounded-lg text-center ">Click & Collect</label>
                </td>
                <td>
                    <input type="checkbox" id="business-delivery-deliv" name="delivery" value="1" class="mt-3 ml-8 mr-2" />
                    <label for="business-delivery-deliv" class=" text-black border-1 border-black rounded-lg text-center ">Delivery</label>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <textarea type="text" name="desc" placeholder="Your business description..." class="resize-none rounded-md text-black border-1 border-black w-6/6 h-20 mt-2" required></textarea>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <button type="submit" class="w-full bg-blue-800 text-white py-2 px-4 rounded-md hover:bg-blue-900">Submit Business</button>
                </td>
            </tr>
        </table>
        </form>
<% }%>